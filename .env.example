# Copy to `.env` and adjust. `.env` is git-ignored; never commit real values.
# Every variable read by `triage.config.Settings` is listed here (enforced by tests).
# The values below run the system against the local LLM stub (added in Phase 4);
# they contain no real credentials, provider endpoints or model identifiers.

# --- Application ---------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = one JSON object per line (required for log aggregation); false = console
LOG_JSON=true

# --- Corpus --------------------------------------------------------------------
# The single PostgreSQL major version indexed (decision D-1). Only 17 is accepted.
PG_DOCS_MAJOR_VERSION=17

# --- LLM provider (OpenAI-compatible chat-completions API) ---------------------
# Base URL of the provider. Default points at the in-compose stub service.
LLM_BASE_URL=http://llm-stub:8080/v1
# Provider API key. Use a free-tier key with a spending limit. Never commit it.
LLM_API_KEY=not-a-real-key-replace-me
# Model identifier as named by your provider. "stub" is accepted only by the stub.
LLM_MODEL=stub
# Per-call timeout in seconds; must be shorter than both wall-clock limits below.
LLM_TIMEOUT_S=20
# Retries per call on retryable errors (0-5), with exponential backoff.
LLM_MAX_RETRIES=3

# --- Agent loop bounds (requirement A1) ----------------------------------------
# Maximum graph steps per investigator run.
AGENT_MAX_STEPS=12
# Maximum tool calls per investigator run; must not exceed AGENT_MAX_STEPS.
AGENT_MAX_TOOL_CALLS=10
# Wall-clock budget (seconds) for one investigator run.
AGENT_WALL_CLOCK_S=90
# Wall-clock budget (seconds) for one verifier run.
VERIFIER_WALL_CLOCK_S=45
